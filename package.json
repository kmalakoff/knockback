{
  "name": "@mcpeasy/knockback",
  "version": "2.0.15",
  "description": "Knockback.js provides Knockout.js magic for Backbone.js Models and Collections",
  "keywords": [
    "knockback",
    "knockbackjs",
    "backbone",
    "backbonejs",
    "knockout",
    "knockoutjs",
    "typescript"
  ],
  "homepage": "http://kmalakoff.github.com/knockback/",
  "repository": {
    "type": "git",
    "url": "http://github.com/kmalakoff/knockback.git"
  },
  "license": "MIT",
  "author": {
    "name": "Kevin Malakoff",
    "url": "https://github.com/kmalakoff"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json",
    "./umd": "./dist/umd/@mcpeasy/knockback.cjs"
  },
  "main": "dist/cjs/index.js",
  "source": "src/index.ts",
  "types": "dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsds build",
    "docs": "tsds docs",
    "format": "tsds format",
    "prepublishOnly": "node scripts/require-dist-tag.cjs && npm run validate",
    "test": "npm run test:types && npm run test:browser && npm run test:node",
    "test:browser": "tsds test:browser --config wtr.config.mjs \"test/integration/relationships/browser-matrix.test.ts\" \"test/exports/*.test.{ts,mjs,cjs}\" \"test/integration/browser-local-artifacts.test.ts\" \"test/integration/model-ref.test.ts\" \"test/unit/*.test.ts\" \"!test/unit/aaa-backbone-relational.test.ts\" \"!test/unit/zzz-backbone-orm.test.ts\"",
    "test:engines": "npm run test:types && npm run test:browser && nvu 18.0.0 tsds test:node --no-timeouts && nvu engines tsds test:node --no-timeouts",
    "test:node": "tsds test:node --no-timeouts",
    "test:packed": "node test/integration/package-types/run-packed.ts",
    "test:safe": "node scripts/test-safe.ts -- npm test",
    "test:types": "npm run build && node test/integration/package-types/run.ts && npm run test:packed",
    "validate": "npm run test:types && tsds validate",
    "version": "tsds version"
  },
  "dependencies": {
    "@types/backbone": "*"
  },
  "devDependencies": {
    "@types/knockout": "*",
    "@types/mocha": "*",
    "@types/node": "^18",
    "@types/underscore": "*",
    "@web/dev-server-import-maps": "^0.3.0",
    "backbone": "^1.6.1",
    "backbone-associations": "0.6.2",
    "backbone-legacy": "npm:backbone@1.2.3",
    "backbone-modelref": "file:../backbone-modelref",
    "backbone-orm": "^0.7.0",
    "backbone-relational": "^0.10.0",
    "fs-remove-compat": "*",
    "knockout": "^3.5.1",
    "ts-dev-stack": "*",
    "tsds-build": "1.23.3",
    "tsds-config": "*",
    "tsds-mocha": "1.24.0",
    "tsds-validate": "1.7.9",
    "tsds-web-test-runner": "1.21.0",
    "underscore": "^1.13.8"
  },
  "peerDependencies": {
    "backbone": ">=1.4.0",
    "knockout": ">=3.5.0",
    "underscore": ">=1.13.8"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "@swc/core@1.16.2": true,
    "core-js-pure": false,
    "esbuild@0.28.2": true,
    "fsevents": false,
    "node-filename-to-dist-paths@1.4.0": true,
    "node-semvers@1.7.0": true,
    "thread-sleep-compat": false
  },
  "tsds": {
    "entry": "src/umd.ts",
    "targets": [
      "cjs",
      "esm",
      "umd"
    ],
    "globals": {
      "@types/backbone": "Backbone",
      "backbone": "Backbone",
      "knockout": "ko",
      "underscore": "_"
    }
  }
}
