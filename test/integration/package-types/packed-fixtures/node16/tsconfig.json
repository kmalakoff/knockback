{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "erasableSyntaxOnly": false,
    "esModuleInterop": true,
    "lib": ["ES2022", "dom"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": []
  },
  "include": ["src"]
}
